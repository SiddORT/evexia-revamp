# Development uses Replit's managed DATABASE_URL. Never put a real credential in this file.
APP_ENV=development
# Provide JWT_SECRET (or an existing SESSION_SECRET) through Replit Secrets, 32+ characters.
# JWT_SECRET=<set in Replit Secrets>
JWT_ISSUER=evexia
JWT_AUDIENCE=evexia-api
# ACCESS_TOKEN_MINUTES: 1-60; REFRESH_TOKEN_DAYS: 1-30
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# SESSION_REFRESH_HOURS: 1-24; browser-session mode defaults to 12 hours server-side.
SESSION_REFRESH_HOURS=12
# Set only in the managed backend secret store before first bootstrap.
# SUPER_ADMIN_INITIAL_PASSWORD=<set in Replit Secrets>
# Staff secrets are independent random 32-byte keys, never JWT/session keys.
# STAFF_ENCRYPTION_KEYS=<secret JSON key-ID to base64-key map>
STAFF_ENCRYPTION_KEY_ID=primary
# STAFF_EMAIL_INDEX_KEY=<independent base64 key in Replit Secrets>
ALLOW_PUBLIC_REGISTRATION=false
# Explicit origins only, comma-separated; never use * with credentials.
CORS_ORIGINS=
# File defaults: 20 MiB body limit, 5-minute grants, 30 operations per user per
# rolling 15 minutes, 4 global concurrent operations across API workers, and a
# 30-second total raw-body read deadline.
MAX_UPLOAD_BYTES=20971520
DOWNLOAD_GRANT_SECONDS=300
FILE_RATE_LIMIT=30
FILE_CONCURRENCY_LIMIT=4
FILE_REQUEST_TIMEOUT_SECONDS=30
# Default local adapter needs a private, absolute, normalized writable path.
# No default root exists. This is suitable only for a durable local disk.
STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT=/absolute/private/path
# Scanner defaults closed: uploads without an available scanner stay quarantined.
SCANNER_BACKEND=unavailable
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
SCANNER_TIMEOUT_SECONDS=10
# Optional S3-compatible storage; not required for auth. No local file fallback.
# S3 requires S3_BUCKET and S3_REGION. Endpoint must use HTTPS when provided.
# Credentials must be supplied via Replit Secrets / the provider's identity chain.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint.example
# AWS_ACCESS_KEY_ID=<set in Replit Secrets>
# AWS_SECRET_ACCESS_KEY=<set in Replit Secrets>