# Development uses Replit's managed DATABASE_URL. Never put a real credential in this file.
APP_ENV=development
# Provide JWT_SECRET (or an existing SESSION_SECRET) through Replit Secrets, 32+ characters.
# JWT_SECRET=<set in Replit Secrets>
JWT_ISSUER=evexia
JWT_AUDIENCE=evexia-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ALLOW_PUBLIC_REGISTRATION=false
# Explicit origins only, comma-separated; never use * with credentials.
CORS_ORIGINS=
# Optional S3-compatible storage; not required for auth. No local file fallback.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint.example
# AWS_ACCESS_KEY_ID=<set in Replit Secrets>
# AWS_SECRET_ACCESS_KEY=<set in Replit Secrets>