{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8080}",
    "build": "uv sync --frozen --no-dev",
    "start": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8080}",
    "typecheck": "python -m compileall -q backend/app backend/alembic"
  }
}
