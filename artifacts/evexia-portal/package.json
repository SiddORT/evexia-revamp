{
  "name": "@workspace/evexia-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js --host 0.0.0.0",
    "build": "vite build --config vite.config.js",
    "test:admin-session": "node --test src/auth/adminSession.test.js",
    "test:move-stocks": "node --test src/services/moveStocksDemo.test.js",
    "test:move-stocks:browser": "sh ../../scripts/run-authenticated-previews.sh artifacts/evexia-portal/tests/move-stocks.preview.spec.mjs",
    "test:startup-bundle": "node --test tests/startup-bundle.test.mjs",
    "test:loaders:browser": "sh ../../scripts/run-authenticated-previews.sh artifacts/evexia-portal/tests/loaders.preview.spec.mjs artifacts/evexia-portal/tests/admin-auth.preview.spec.mjs artifacts/evexia-portal/tests/activity-logs.preview.spec.mjs",
    "test:template-preferences:service": "node --test src/services/templatePreferenceEvents.test.js",
    "test:template-preferences:browser": "sh ../../scripts/run-authenticated-previews.sh artifacts/evexia-portal/tests/template-preferences.preview.spec.mjs",
    "test:template-preferences": "pnpm run test:template-preferences:service && pnpm run test:template-preferences:browser",
    "serve": "vite preview --config vite.config.js --host 0.0.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "wouter": "^3.3.5"
  }
}
