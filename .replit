modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "release"

[[workflows.workflow]]
name = "release"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run validate:release"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["cacert", "cargo", "enchant", "freetype", "hyphen", "icu74", "lcms2", "libavif", "libiconv", "libimagequant", "libjpeg", "libmanette", "libsecret", "libtiff", "libwebp", "libxcrypt", "nano", "openjpeg", "openssl", "patchelf", "pkg-config", "postgresql", "rustc", "tcl", "tk", "zlib", "nginx"]

[userenv]

[userenv.development]
EVEXIA_NIX_BROWSER_LIBRARY_SOURCE = "/nix/store/q70d15vcgipibv45yxp44hdjfhdmdmg5-playwright-browsers"
EVEXIA_NIX_BROWSER_LOADER = "/repl/tools/qqiqd3ah10x8hzsif4j1y4xc1miw23nx-glibc-2.42-67/lib/ld-linux-x86-64.so.2"
EVEXIA_NIX_DOWNLOAD_ENGINES = "1"
CORS_ORIGINS = "https://9bd1d1ea-b7fe-4e8b-8aa6-02e5591a96a0-00-4nbv234okadk.sisko.replit.dev"
